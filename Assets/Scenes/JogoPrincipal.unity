  m_Script: {fileID: 11500000, guid: 538828b645d33c64c9b7fcf5b82464cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textoLeitura: "As est\xE1tuas maias s\xE3o esculturas de pedra, gesso (estuque)
    ou cer\xE2mica que floresceram na Mesoam\xE9rica (aprox. 250-900 d.C.), caracterizadas
    por um estilo naturalista e rico em detalhes. Elas retratam deuses, governantes
    e rituais, adornando templos e pal\xE1cios com figuras humanas vestindo trajes
    complexos de plumas de quetzal e jade."
  corDoTextoLido: {r: 0, g: 0, b: 0, a: 1}
  teclaLeitura: 101
  alcance: 3
  corTexto: {r: 1, g: 1, b: 1, a: 1}
  tamanhoFont: 22
