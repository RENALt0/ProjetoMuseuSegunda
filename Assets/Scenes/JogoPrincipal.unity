  m_Script: {fileID: 11500000, guid: 538828b645d33c64c9b7fcf5b82464cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textoLeitura: "Xiphactinus \xE9 coloquialmente referido como peixe-X, \xE9 um g\xEAnero
    extinto de grandes peixes \xF3sseos marinhos predadores que viveram desde o final
    do Albiano at\xE9 o final do Maastrichtiano. O g\xEAnero cresceu at\xE9 5\u20136
    metros de comprimento e superficialmente se assemelhava a um gigantesco tarp\xE3o
    com presas. E, tinha dentes enormes que poderiam capturar muitas presas."
  corDoTextoLido: {r: 0, g: 0, b: 0, a: 1}
  teclaLeitura: 101
  alcance: 3
  corTexto: {r: 1, g: 1, b: 1, a: 1}
