  m_Script: {fileID: 11500000, guid: 538828b645d33c64c9b7fcf5b82464cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textoLeitura: "Poste de ilumina\xE7\xE3o p\xFAblica instalado nas ruas de Boston
    no in\xEDcio do s\xE9culo XX, geralmente em ferro fundido e com l\xE2mpadas a
    g\xE1s ou el\xE9tricas incipientes. Reflete o per\xEDodo de transi\xE7\xE3o tecnol\xF3gica
    da ilumina\xE7\xE3o urbana, quando cidades modernas come\xE7aram a substituir
    o g\xE1s pela eletricidade."
