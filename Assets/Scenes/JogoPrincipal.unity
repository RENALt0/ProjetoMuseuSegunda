  m_Script: {fileID: 11500000, guid: 538828b645d33c64c9b7fcf5b82464cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textoLeitura: "O \"Santu\xE1rio de An\xFAbis\" \xE9 um famoso item funer\xE1rio
    encontrado na tumba do fara\xF3 Tutanc\xE2mon (KV62) no Vale dos Reis em 1922.
    A pe\xE7a, um chacal negro de madeira com detalhes em ouro sobre um ba\xFA, servia
    como amuleto de prote\xE7\xE3o e representava o deus da mumifica\xE7\xE3o. Atualmente,
    est\xE1 em exibi\xE7\xE3o no Museu Eg\xEDpcio do Cairo."
  corDoTextoLido: {r: 0, g: 0, b: 0, a: 1}
  teclaLeitura: 101
  alcance: 3
  corTexto: {r: 1, g: 1, b: 1, a: 1}
  tamanhoFont: 22
